<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg_dark">

    <!-- Üst Başlık & Geri Sayım Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Sol İkon Kutusu (Tik Widget'ı ile Birebir Uyumlu) -->
        <LinearLayout
            android:id="@+id/layout_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_pill_bg_dark"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_prayer_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕌"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Sol Orta: Şehir, İlçe ve Şu Anki Vakit -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_location_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kocaeli, Gölcük"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_current_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Şu an: Öğle Vakti"
                android:textColor="#10B981"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Sağ: Geri Sayım Rozeti -->
        <LinearLayout
            android:id="@+id/layout_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg_dark"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_countdown_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İkindi'ye Kalan"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_countdown_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="01:13:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ayırıcı Çizgi -->
    <FrameLayout
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#1E293B" />

    <!-- Alt Bölüm: 6 Vakit Çizelgesi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 1. İmsak -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <LinearLayout
                android:id="@+id/box_imsak_inactive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_inactive_dark"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/label_imsak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İmsak"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/time_imsak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="04:52"
                    android:textColor="#F8FAFC"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_imsak_active"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_active"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İmsak"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/time_imsak_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="04:52"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Güneş -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <LinearLayout
                android:id="@+id/box_gunes_inactive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_inactive_dark"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/label_gunes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Güneş"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/time_gunes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="06:21"
                    android:textColor="#F8FAFC"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_gunes_active"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_active"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Güneş"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/time_gunes_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="06:21"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 3. Öğle -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <LinearLayout
                android:id="@+id/box_ogle_inactive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_inactive_dark"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/label_ogle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Öğle"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/time_ogle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="13:05"
                    android:textColor="#F8FAFC"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_ogle_active"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_active"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Öğle"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/time_ogle_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="13:05"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 4. İkindi -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <LinearLayout
                android:id="@+id/box_ikindi_inactive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_inactive_dark"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/label_ikindi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İkindi"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/time_ikindi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="17:41"
                    android:textColor="#F8FAFC"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_ikindi_active"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_active"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İkindi"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/time_ikindi_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="17:41"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 5. Akşam -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <LinearLayout
                android:id="@+id/box_aksam_inactive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_inactive_dark"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/label_aksam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akşam"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/time_aksam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="19:39"
                    android:textColor="#F8FAFC"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_aksam_active"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_active"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akşam"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/time_aksam_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="19:39"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 6. Yatsı -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <LinearLayout
                android:id="@+id/box_yatsi_inactive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_inactive_dark"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/label_yatsi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yatsı"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/time_yatsi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="21:05"
                    android:textColor="#F8FAFC"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_yatsi_active"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_badge_active"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yatsı"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/time_yatsi_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="21:05"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#EF4444"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
